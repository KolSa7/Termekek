<Window x:Class="Termekek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Termekek"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <StackPanel Margin="10,10,10,10">
            <Label Content="Új termék hozzáadása:"/>
            <TextBox x:Name="tbox_input" Margin="10,10,10,10"/>
            <Button x:Name="btn_hozzaadas" Content="Hozzáadás" Click="btn_hozzaadas_Click" />

            <Label Content="Termékek:"/>
            <ListBox x:Name="lbox_termekek" Margin="0,0,0,10" SourceUpdated="lbox_termekek_SourceUpdated" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <Button x:Name="btn_torles" Content="Törlés" Margin="10,10,10,10" Click="btn_torles_Click" />
                <Button x:Name="btn_torlesAll" Content="Összes törlése" Margin="10,10,10,10" Click="btn_torlesAll_Click" />
                <TextBlock x:Name="tb_sum" Text="Termékek száma: 0" Margin="10,10,10,10"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
